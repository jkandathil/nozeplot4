              "expand":  {}
            },
            "group_by": { "using": "concentration_exact_value" },
            "plot_kwargs": { "linewidth": 3 , "num_columns": 4,"display_trial_number":true, "trial_number_position":"start"},
            "output_kwargs": {
              "filename": "individual_plots_Selected_Elements_skip_events"
            }
